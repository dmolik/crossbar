{
    "manifest_version": 3,
    "name": "Crossbar",
    "short_name": "Crossbar",
    "version": "1.5.0",
    "description": "__MSG_extShortDesc__",
    "icons": {
        "16": "img/icon_16.png",
        "128": "img/icon_128.png"
    },
    "action": {
        "default_icon": {
            "19": "img/browsericons/icon19-19.png"
        },
        "default_title": "Crossbar",
        "default_popup": "popup.html"
    },
    "author": "Raymond Hill",
    "background": {
        "service_worker": "js/sw.js"
    },
    "content_scripts": [
    {
        "matches": ["http://*/*", "https://*/*"],
        "js": ["/js/vapi.js", "/js/vapi-client.js", "/js/contentscript-start.js"],
        "run_at": "document_start",
        "all_frames": true
        },
    {
        "matches": ["http://*/*", "https://*/*"],
        "js": ["/js/contentscript.js"],
        "run_at": "document_end",
        "all_frames": true
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "default_locale": "en",
    "homepage_url": "https://github.com/dmolik/crossbar",
    "host_permissions": [
        "<all_urls>"
    ],
    "minimum_chrome_version": "120.0",
    "options_ui": {
        "page": "dashboard.html",
        "open_in_tab": true
    },
    "permissions": [
        "browsingData",
        "cookies",
        "declarativeNetRequest",
        "privacy",
        "scripting",
        "storage",
        "tabs",
        "unlimitedStorage",
        "webNavigation",
        "webRequest"
    ],
    "web_accessible_resources": [
        {
            "resources": [ "main-blocked.html" ],
            "matches": [ "<all_urls>" ]
        }
    ]
}
